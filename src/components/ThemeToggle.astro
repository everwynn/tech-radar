---
/**
 * 主题切换（浅色 → 深色 → 跟随系统）。
 *
 * 与 everwynn.github.io 门户保持同样的三态交互，但这里用的是 class 模式
 * （global.css 的 html.dark），所以 apply() 只切 class + data-theme-mode，
 * 不走 View Transitions 的圆形揭示，减少本项目的脚本面积。
 */
---

<button
  type="button"
  data-theme-toggle
  class="relative inline-flex h-8 w-8 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-ink/40 hover:text-ink"
  aria-label="切换主题"
  title="切换主题"
>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path stroke-linecap="round" d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10l1.4 1.4m0-12.8l-1.4 1.4m-10 10l-1.4 1.4"></path>
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.7 15.9A8.6 8.6 0 0 1 10 3.3a9 9 0 1 0 10.7 12.6Z"></path>
  </svg>
  <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path stroke-linecap="round" d="M9 20h6m-3-4v4"></path>
  </svg>
</button>

<style>
  .theme-icon {
    display: none;
    width: 16px;
    height: 16px;
  }

  html[data-theme-mode='light'] .theme-icon-sun,
  html[data-theme-mode='dark'] .theme-icon-moon,
  html[data-theme-mode='system'] .theme-icon-system {
    display: block;
  }

  /* data-theme-mode 尚未写入时的兜底，避免按钮空白 */
  html:not([data-theme-mode]) .theme-icon-system {
    display: block;
  }
</style>

<script is:inline>
  (function () {
    // 页面可能渲染多个按钮，脚本只绑定一次，靠事件委托覆盖全部
    if (window.__radarThemeBound) return;
    window.__radarThemeBound = true;

    var ORDER = ['light', 'dark', 'system'];
    var LABEL = { light: '浅色', dark: '深色', system: '跟随系统' };

    function currentMode() {
      return document.documentElement.getAttribute('data-theme-mode') || 'system';
    }

    function nextMode(mode) {
      return ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    }

    function syncLabels() {
      var mode = currentMode();
      var next = nextMode(mode);
      var buttons = document.querySelectorAll('[data-theme-toggle]');
      Array.prototype.forEach.call(buttons, function (button) {
        button.setAttribute(
          'aria-label',
          '切换主题：当前' + LABEL[mode] + '，点击切换到' + LABEL[next],
        );
        button.setAttribute('title', LABEL[mode] + ' · 点击切换到' + LABEL[next]);
      });
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-theme-toggle]');
      if (!button) return;
      var theme = window.__radarTheme;
      if (!theme) return;
      theme.apply(nextMode(currentMode()), true);
      syncLabels();
    });

    syncLabels();
  })();
</script>
