---
// 项目体检面板：粘贴依赖清单，在浏览器里查 npm latest 与 OSV。构建期不参与，也不上传任何内容。
---
<section id="audit" class="scroll-mt-20 rounded-xl border border-line bg-surface p-4 sm:p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-[15px] font-semibold tracking-tight">项目体检</h2>
    <p class="text-[11px] text-muted">粘贴依赖清单，一次看出每个包落后多少、有几个已知漏洞</p>
  </div>

  <form class="mt-4 flex flex-col gap-2" data-audit-form>
    <label class="flex flex-col gap-1">
      <span class="text-[11px] text-muted">package.json 片段，或每行「包名 版本」</span>
      <textarea
        name="deps"
        rows="6"
        spellcheck="false"
        data-audit-input
        placeholder={'{\n  "dependencies": {\n    "vue": "^3.3.0",\n    "astro": "4.16.19"\n  }\n}'}
        class="w-full resize-y rounded-md border border-line bg-canvas px-2.5 py-2 font-mono text-[12px] leading-relaxed text-ink placeholder:text-muted focus:border-ink/40 focus:outline-none"
      ></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-2">
      <button
        type="submit"
        class="h-9 rounded-md bg-ink px-4 text-[13px] font-medium text-canvas transition hover:opacity-90 disabled:opacity-50"
      >
        体检
      </button>
      <button
        type="button"
        data-audit-example
        class="h-9 rounded-md border border-line px-3 text-[12px] text-muted transition hover:border-ink/30 hover:text-ink"
      >
        填入示例
      </button>
      <span class="text-[11px] text-muted">最多 40 个包，只在浏览器里请求 npm 与 OSV</span>
    </div>
  </form>

  <div class="mt-3" data-audit-result aria-live="polite">
    <p class="text-[11px] text-muted">粘贴后点「体检」。这里不会读取你的项目，也不会保存粘贴的内容。</p>
  </div>

  <p class="mt-4 border-t border-line pt-3 text-[11px] leading-relaxed text-muted">
    版本取 npm registry 的 latest 标签，漏洞来自 OSV；只统计当前版本命中的公告条目，不等于安全结论。解析不了的写法会单独列出，不做猜测。
  </p>
</section>

<script>
  import { MAX_DEPS, parseDeps, summarizeAudit, sortAuditRows } from '../lib/deps.mjs';
  import { auditDeps, type AuditOutcome, type AuditRow } from '../lib/audit';
  import { SEVERITY_TEXT, SEVERITY_TONE } from '../lib/vuln-ui';

  const form = document.querySelector<HTMLFormElement>('[data-audit-form]');
  const input = document.querySelector<HTMLTextAreaElement>('[data-audit-input]');
  const result = document.querySelector<HTMLDivElement>('[data-audit-result]');
  const exampleButton = document.querySelector<HTMLButtonElement>('[data-audit-example]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const EXAMPLE = ['vue ^3.3.0', 'astro 3.0.0', 'lodash 4.17.20', 'axios 0.21.1'].join('\n');

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function gapTone(row: AuditRow) {
    if (!row.gap || row.gap.level === 'none') return row.ahead ? 'text-muted' : 'text-ok';
    return 'text-warn';
  }

  function renderSkipped(container: HTMLElement, parsed: ReturnType<typeof parseDeps>) {
    if (parsed.skipped.length) {
      const details = el('details', 'mt-2 text-[11px] text-muted');
      details.append(
        el('summary', 'cursor-pointer list-none hover:text-ink', `已跳过 ${parsed.skipped.length} 个（无法落到具体版本）`),
      );
      const list = el('ul', 'mt-1 space-y-0.5');
      for (const item of parsed.skipped) {
        list.append(el('li', 'truncate font-mono', `${item.name} ${item.raw || '—'} · ${item.reason}`));
      }
      details.append(list);
      container.append(details);
    }
    if (parsed.overflow) {
      container.append(
        el('p', 'mt-1 text-[11px] text-muted', `另有 ${parsed.overflow} 个包超出 ${MAX_DEPS} 个上限，未查询。`),
      );
    }
  }

  function vulnLine(vuln: AuditRow['vulns'][number]) {
    const item = el('li', 'flex items-baseline gap-1.5 text-[11px]');
    item.append(el('span', `shrink-0 ${SEVERITY_TONE[vuln.severity]}`, SEVERITY_TEXT[vuln.severity]));
    const link = el(
      'a',
      'min-w-0 truncate font-mono text-muted hover:text-ink hover:underline',
      vuln.fixed ? `${vuln.id} · 修复于 ${vuln.fixed}` : `${vuln.id} · 未公布修复`,
    );
    link.href = vuln.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    if (vuln.summary) link.title = vuln.summary;
    item.append(link);
    return item;
  }

  function rowItem(row: AuditRow) {
    const item = el('li', 'border-t border-line py-2');
    const head = el('div', 'flex items-baseline justify-between gap-3');
    const name = el('a', 'min-w-0 truncate font-mono text-[12px] text-ink hover:underline', row.name);
    name.href = `https://www.npmjs.com/package/${row.name}`;
    name.target = '_blank';
    name.rel = 'noopener noreferrer';
    head.append(
      name,
      el('span', `shrink-0 text-[11px] ${gapTone(row)}`, row.latest ? row.gapLabel : '未查到最新版本'),
    );
    item.append(head);

    if (row.latest) {
      const line = el('div', 'mt-0.5 flex flex-wrap items-baseline gap-x-1.5 font-mono text-[11px] text-muted');
      line.append(el('span', '', row.current), el('span', '', '→'), el('span', 'text-ink', row.latest));
      // 保留用户原始写法，让人确认自己写的是 ^3.3.0 还是 3.3.0
      if (row.raw && row.raw !== row.current) line.append(el('span', '', `（${row.raw}）`));
      item.append(line);
    } else if (row.note) {
      item.append(el('p', 'mt-0.5 text-[11px] text-muted', row.note));
    }

    if (row.vulns.length) {
      const list = el('ul', 'mt-1 space-y-0.5');
      // 一个老版本可能命中几十条公告，默认只展开前几条，避免整个面板被漏洞淹没
      const limit = 3;
      for (const vuln of row.vulns.slice(0, limit)) list.append(vulnLine(vuln));
      item.append(list);

      const rest = row.vulns.slice(limit);
      if (rest.length) {
        const more = el(
          'button',
          'mt-1 text-[11px] text-muted underline decoration-dotted hover:text-ink',
          `展开其余 ${rest.length} 条`,
        );
        more.type = 'button';
        more.addEventListener('click', () => {
          for (const vuln of rest) list.append(vulnLine(vuln));
          more.remove();
        });
        item.append(more);
      }
    }
    return item;
  }

  function renderOutcome(outcome: AuditOutcome, parsed: ReturnType<typeof parseDeps>) {
    if (!result) return;
    const stats = summarizeAudit(outcome.rows);
    const container = el('div');

    const head = el('div', 'flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[11px]');
    head.append(el('span', 'font-medium text-ink', `共 ${stats.total} 个包`));
    head.append(
      el('span', stats.outdated ? 'text-warn' : 'text-ok', stats.outdated ? `· ${stats.outdated} 个落后` : '· 全部已是最新'),
    );
    if (stats.vulnerable) {
      head.append(el('span', 'font-medium text-danger', `· ${stats.vulnerable} 个有漏洞（${stats.vulnTotal} 条公告）`));
    } else if (!outcome.osvFailed) {
      head.append(el('span', 'text-ok', '· 未发现已知漏洞'));
    }
    if (stats.failed) head.append(el('span', 'text-muted', `· ${stats.failed} 个未查到最新版本`));
    container.append(head);

    if (outcome.osvFailed) {
      container.append(el('p', 'mt-2 text-[11px] text-warn', '本次漏洞批量查询失败，结论里不含漏洞信息，可稍后重试。'));
    } else if (outcome.vulnFailures) {
      container.append(
        el('p', 'mt-2 text-[11px] text-muted', `其中 ${outcome.vulnFailures} 个包的漏洞详情查询失败，可稍后重试。`),
      );
    }

    renderSkipped(container, parsed);

    const list = el('ul', 'mt-2');
    for (const row of sortAuditRows(outcome.rows) as AuditRow[]) list.append(rowItem(row));
    container.append(list);

    result.replaceChildren(container);
  }

  if (form && input && result) {
    exampleButton?.addEventListener('click', () => {
      input.value = EXAMPLE;
      input.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitButton?.disabled) return;

      const parsed = parseDeps(input.value);
      result.replaceChildren();

      if (parsed.format === 'empty') {
        result.append(el('p', 'text-[12px] text-warn', '先粘贴 package.json 片段，或每行写「包名 版本」。'));
        return;
      }
      if (!parsed.deps.length) {
        result.append(el('p', 'text-[12px] text-warn', '没有识别到可对比的依赖。'));
        renderSkipped(result, parsed);
        return;
      }

      const progress = el('p', 'text-[11px] text-muted', `正在查询 npm 最新版本（0/${parsed.deps.length}）…`);
      result.append(progress);
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = '查询中…';
      }

      try {
        const outcome = await auditDeps(parsed.deps, (state) => {
          progress.textContent = `正在查询 npm 最新版本（${state.done}/${state.total}）…`;
        });
        renderOutcome(outcome, parsed);
      } catch {
        result.replaceChildren(el('p', 'text-[12px] text-danger', '体检失败：网络请求异常，请稍后重试。'));
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = '体检';
        }
      }
    });
  }
</script>
