---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在 · Tech Radar" description="请求的页面不存在。" noindex>
  <div class="py-20 text-center">
    <p class="font-mono text-[12px] tracking-[0.2em] text-muted">404</p>
    <h1 class="mt-3 text-xl font-semibold tracking-tight">页面不存在</h1>
    <p class="mt-2 text-[13px] text-muted">链接可能已经失效，或者路径拼错了。</p>
    <a
      href={base}
      class="mt-6 inline-flex rounded-md border border-line px-3.5 py-2 text-[13px] transition-colors hover:border-ink/40 hover:text-ink"
    >
      返回清单
    </a>
  </div>
</BaseLayout>
