---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparePanel from '../components/ComparePanel.astro';
import TechCard from '../components/TechCard.astro';
import { getItems, getUpdatedAt, getSources, groupItems, summarize } from '../lib/catalog';
import { formatAbsolute, formatRelative } from '../lib/format';

const items = getItems();
const stats = summarize(items);
const sections = groupItems(items);
const updatedAt = getUpdatedAt();
const sources = getSources();

const SOURCE_LABELS: Record<string, string> = {
  endoflife: 'endoflife.date',
  npm: 'npm registry',
  github: 'GitHub Releases',
};
const sourceEntries = Object.entries(sources);
---

<BaseLayout
  title="技术栈版本雷达"
  description="查询指定技术的最新版本、每条版本线的 EOL 日期与任意版本的已知漏洞，数据每天自动更新。"
>
  <section class="rounded-xl border border-line bg-surface p-5">
    <h1 class="text-[22px] font-semibold leading-tight tracking-tight sm:text-[26px]">技术栈版本雷达</h1>
    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed text-muted">
      收录 {stats.total} 项技术的版本事实：最新稳定版、每条版本线的支持截止日期，以及任意版本的已知漏洞。
      这里不假设你在用什么版本——输入你手上的版本，就能看到它落后多少、是否还在支持期内。
    </p>

    <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-line pt-4 sm:grid-cols-4">
      <div>
        <dt class="text-[11px] text-muted">收录技术</dt>
        <dd class="mt-1 font-mono text-[20px] leading-none">{stats.total}<span class="ml-1 text-[11px] text-muted">项</span></dd>
      </div>
      <div>
        <dt class="text-[11px] text-muted">有版本线</dt>
        <dd class="mt-1 font-mono text-[20px] leading-none">{stats.withLifecycle}<span class="ml-1 text-[11px] text-muted">项</span></dd>
      </div>
      <div>
        <dt class="text-[11px] text-muted">可查漏洞</dt>
        <dd class="mt-1 font-mono text-[20px] leading-none">{stats.withVulns}<span class="ml-1 text-[11px] text-muted">项</span></dd>
      </div>
      <div>
        <dt class="text-[11px] text-muted">数据更新</dt>
        <dd class="mt-1 text-[13px]" title={formatAbsolute(updatedAt)}>{updatedAt ? formatRelative(updatedAt) : '尚未抓取'}</dd>
      </div>
    </dl>

    {sourceEntries.length > 0 && (
      <p class="mt-3 text-[11px] text-muted">
        数据源：
        {sourceEntries.map(([key, state], index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <span class:list={[state === 'ok' ? 'text-ok' : state === 'skipped' ? 'text-muted' : 'text-danger']}>
              {SOURCE_LABELS[key] ?? key} {state === 'ok' ? '正常' : state === 'skipped' ? '未使用' : '异常'}
            </span>
          </>
        ))}
      </p>
    )}
  </section>

  <div class="mt-4">
    <ComparePanel items={items} />
  </div>

  <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-[15px] font-semibold tracking-tight">技术清单</h2>
    <label class="flex items-center gap-2">
      <span class="sr-only">搜索技术</span>
      <input
        type="search"
        data-search-input
        placeholder="搜索技术名或版本号"
        autocomplete="off"
        class="h-8 w-full rounded-md border border-line bg-surface px-2 text-[12px] text-ink placeholder:text-muted sm:w-56"
      />
    </label>
  </div>

  <div data-groups>
    {sections.map((section) => (
      <section class="mt-4" data-group-section data-group={section.group}>
        <h3 class="mb-2 text-[11px] font-medium uppercase tracking-wider text-muted">{section.label}</h3>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {section.items.map((item) => <TechCard item={item} />)}
        </div>
      </section>
    ))}
  </div>

  <p class="mt-6 hidden text-[12px] text-muted" data-empty-result>
    没有匹配的技术，换个关键词试试。搜索支持技术名、分组名和版本号。
  </p>

  {items.length === 0 && (
    <p class="mt-6 rounded-xl border border-dashed border-line p-6 text-center text-[12px] text-muted">
      还没有数据。在本地执行 <code class="font-mono">npm run fetch</code> 生成 catalog.json 后再构建。
    </p>
  )}

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const empty = document.querySelector<HTMLElement>('[data-empty-result]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tech-card]'));
    const groupSections = Array.from(document.querySelectorAll<HTMLElement>('[data-group-section]'));

    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const haystack = card.dataset.search ?? '';
        const match = !query || haystack.includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      }

      // 分组标题跟着内容一起隐藏，避免留下空标题
      for (const section of groupSections) {
        section.hidden = !section.querySelector('[data-tech-card]:not([hidden])');
      }
      if (empty) empty.hidden = visible > 0;
    });
  </script>
</BaseLayout>
